# Copia este archivo como .env y rellena los valores si quieres conectar tu tienda Shopify.
# Si no creas .env, la app usará datos mock en local.

# Shopify Configuration
VITE_SHOPIFY_STORE_DOMAIN=mrbrownmx.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=ad03aab414e8a8da8c419222d265c7a5

# Newsletter / Admin API (server-side only — used by api/newsletter.ts)
# Do NOT prefix with VITE_ (these must not be exposed to the browser bundle).
SHOPIFY_ADMIN_STORE_DOMAIN=mrbrownmx.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=

# Editor del home (/edicion) — auth simple + persistencia
# En local el Vite plugin guarda en api/_data/home-content.json (sin Shopify).
# En prod POST guarda metafield Shop mrbrown.home_content (necesita Admin token).
EDICION_ADMIN_USER=admin
EDICION_ADMIN_PASSWORD=

# Prod: Vercel Blob para subir banners (preferido; si falta, usa Shopify Files + Admin token)
# Se crea con: npx vercel blob create-store ... --access public
# BLOB_READ_WRITE_TOKEN=

